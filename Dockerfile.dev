# Development Dockerfile with hot-reloading (tsx watch)
FROM node:20-alpine

WORKDIR /app

# Install dependencies first (layer caching)
COPY package*.json ./
RUN npm install

# Copy Prisma schema and generate client
COPY prisma ./prisma
RUN npx prisma generate

# Copy the rest of the application source
COPY . .

EXPOSE 3001

CMD ["npm", "run", "dev"]
