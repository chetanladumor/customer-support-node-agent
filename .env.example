# ==============================================================================
# Node AI Customer Support — Environment Configuration Template
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port (default: 3001)
PORT=3001

# Database connection
# Local Host Direct:  postgresql://postgres:postgrespassword@localhost:5455/swadesh_support_db?schema=public
# Local Docker Stack:  postgresql://postgres:postgrespassword@postgres:5432/swadesh_support_db?schema=public
# AWS RDS Postgres:   postgresql://dbadmin:<PASSWORD>@<RDS_ENDPOINT>:5432/swadesh_support_db?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5455/swadesh_support_db?schema=public"

# Allowed CORS Origins (comma-separated for multiple origins)
# For S3 frontend: http://<bucket-name>.s3-website-<region>.amazonaws.com
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:3000"

# AI Model Provider Credentials
# Google Gemini API Key (Optional — fallback rule-based agent executes if omitted)
GOOGLE_GENERATIVE_AI_API_KEY=""
AI_MODEL="gemini-2.0-flash"

# Optional OpenAI API Key
OPENAI_API_KEY=""

# Optional Redis URL (For distributed rate limiting & embedding cache in scaled production)
REDIS_URL=""
