{
  "name": "node-ai-customer-support",
  "version": "1.0.0",
  "description": "Enterprise Multi-Agent AI Customer Support Platform — Node.js + Express + PostgreSQL + pgvector",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:push": "npx prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test": "tsx scripts/test-api-suite.ts"
  },
  "keywords": [
    "ai",
    "multi-agent",
    "customer-support",
    "express",
    "postgresql",
    "pgvector"
  ],
  "author": "ChetanKumar Ladumor",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/google": "^4.0.45",
    "@ai-sdk/openai": "^4.0.45",
    "@prisma/client": "^6.19.3",
    "@xenova/transformers": "^2.17.2",
    "ai": "^7.0.68",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.9",
    "nodemon": "^3.1.9",
    "prisma": "^6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
